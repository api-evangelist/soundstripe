      "name": "Supe Search",
      "description": {
        "content": "Asynchronous AI music supervisor for natural-language and image-based catalog matching.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "be349a3b-8257-4efa-a1e1-a73839164c1f",
          "name": "Create a Search",
          "request": {
            "name": "Create a Search",
            "description": {
              "content": "Create a Supe AI music supervisor search. Accepts a natural-language `query`, a `context` describing the scene, and/or up to 11 `asset_ids` (10 images + 1 video). At least one of `query`, `context`, or `asset_ids` is required. `callback_url` (HTTPS) is required for asynchronous delivery. Returns 200 immediately when an equivalent search is cached within 24 hours, otherwise 202 with a search ID; final results arrive via the configured webhook.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "supe",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
