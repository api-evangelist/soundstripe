{
  "opencollection": "1.0.0",
  "info": {
    "name": "Soundstripe Categories API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Categories",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Categories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.soundstripe.com/v1/categories"
          },
          "docs": "List sound-effect categories."
        }
      ]
    }
  ],
  "bundled": true
}