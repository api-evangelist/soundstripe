{
  "opencollection": "1.0.0",
  "info": {
    "name": "Soundstripe Categories Songs API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Songs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a Song",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.soundstripe.com/v1/songs/:song_id",
            "params": [
              {
                "name": "song_id",
                "value": "",
                "type": "path",
                "description": "The song's ID."
              }
            ]
          },
          "docs": "Retrieve a song with its primary artist and primary audio file relationships."
        }
      ]
    }
  ],
  "bundled": true
}